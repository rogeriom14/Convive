{
  "expo": {
    "name": "Convive",
    "slug": "convive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.moradorapp.pzbnk6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Escolher a foto da área comum do condomínio.",
        "NSCameraUsageDescription": "Tirar foto da área comum do condomínio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.moradorapp.pzbnk6",
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6C5CE7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolher a foto da área comum do condomínio.",
          "cameraPermission": "Tirar foto da área comum do condomínio.",
          "microphonePermission": false
        }
      ],
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
